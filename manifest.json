{
  "manifest_version": 3,
  "name": "Apply Job Assistant",
  "short_name": "ApplyJob",
  "version": "0.1.0",
  "description": "Match % and skill gaps for any job post, honest resume tailoring, and form autofill that learns. All data stays on your computer.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://openrouter.ai/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "scripts": [
      "src/lib/core.js",
      "src/lib/logger.js",
      "src/lib/errors.js",
      "src/lib/storage.js",
      "src/lib/skills-dictionary.js",
      "src/lib/matcher.js",
      "src/lib/experience.js",
      "src/lib/ai.js",
      "src/lib/tracker.js",
      "src/lib/resume-engine.js",
      "src/lib/tracks.js",
      "src/lib/issue-report.js",
      "src/lib/pdf-writer.js",
      "src/background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.myworkdaysite.com/*",
        "*://*.glassdoor.com/*",
        "*://*.ziprecruiter.com/*",
        "*://*.ashbyhq.com/*",
        "*://*.smartrecruiters.com/*",
        "*://*.icims.com/*",
        "*://*.workable.com/*"
      ],
      "js": [
        "src/lib/core.js",
        "src/lib/logger.js",
        "src/lib/errors.js",
        "src/lib/storage.js",
        "src/lib/skills-dictionary.js",
        "src/lib/matcher.js",
        "src/lib/experience.js",
        "src/lib/tracker.js",
        "src/lib/tracks.js",
        "src/lib/pdf-writer.js",
        "src/content/jd-extractor.js",
        "src/lib/field-rules.js",
        "src/content/form-filler.js",
        "src/content/workday.js",
        "src/content/ats.js",
        "src/content/entries.js",
        "src/content/apply-detector.js",
        "src/content/panel.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Apply Job Assistant",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "src/admin/admin.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "apply-job-assistant@local",
      "strict_min_version": "121.0"
    }
  }
}
